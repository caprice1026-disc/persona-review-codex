{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "request_id",
    "character_id",
    "character_fingerprint",
    "reference_sha256",
    "context_key",
    "reference_asset",
    "expression",
    "reference_path",
    "appearance_data",
    "generator"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "generate"
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "character_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "character_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference_asset": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}\\.(png|jpg|webp)$"
    },
    "expression": {
      "type": "string",
      "enum": [
        "happy",
        "neutral",
        "concerned",
        "stern"
      ]
    },
    "reference_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "appearance_data": {
      "type": "string",
      "maxLength": 2000
    },
    "generator": {
      "type": "string",
      "enum": [
        "Codex image_gen"
      ]
    }
  }
}
