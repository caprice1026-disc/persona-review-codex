{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "character": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "image_mode": {
      "type": "string",
      "enum": [
        "always",
        "cached_only",
        "hybrid",
        "pre_generate",
        "A",
        "B"
      ]
    },
    "review_mode": {
      "type": "string",
      "enum": [
        "auto",
        "diff",
        "full",
        "file"
      ]
    },
    "character_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "persona_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "scope": {
      "type": "string",
      "enum": [
        "auto",
        "diff",
        "full",
        "file"
      ]
    },
    "focus": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "enum": [
          "correctness",
          "security",
          "performance",
          "architecture",
          "maintainability",
          "testing"
        ]
      }
    }
  }
}
