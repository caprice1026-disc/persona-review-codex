{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "character": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
    "image_mode": {"type": "string", "enum": ["A", "B", "hybrid"]},
    "review_mode": {"type": "string", "enum": ["auto", "diff", "full"]}
  }
}
