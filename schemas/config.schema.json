{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "allow_project_overrides",
    "settings",
    "characters"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "allow_project_overrides": {
      "type": "boolean"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "character": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "image_mode": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "hybrid"
          ]
        },
        "review_mode": {
          "type": "string",
          "enum": [
            "auto",
            "diff",
            "full"
          ]
        }
      }
    },
    "characters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "persona",
          "appearance",
          "images"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "persona": {
            "type": "string",
            "maxLength": 2000
          },
          "appearance": {
            "type": "string",
            "maxLength": 2000
          },
          "images": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reference": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}\\.(png|jpg|webp)$"
              },
              "happy": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}\\.(png|jpg|webp)$"
              },
              "neutral": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}\\.(png|jpg|webp)$"
              },
              "concerned": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}\\.(png|jpg|webp)$"
              },
              "stern": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}\\.(png|jpg|webp)$"
              }
            }
          }
        }
      }
    }
  }
}
